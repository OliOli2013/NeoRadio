#!/bin/sh
# NeoRadio v3.0 - remove only NeoRadio installer/update leftovers from /tmp.
# Run after opkg has completed its work with a short delay so the source IPK
# can be safely unlinked regardless of the image/opkg implementation.
(
    sleep 2
    rm -f /tmp/enigma2-plugin-extensions-neoradio*.ipk \
          /tmp/neoradio*.ipk \
          /tmp/NeoRadio*.ipk \
          /tmp/neoradio_update.ipk \
          /tmp/neoradio_update.ipk.part \
          /tmp/neoradio*.part \
          /tmp/NeoRadio*.part 2>/dev/null || true
    rm -rf /tmp/neoradio-ipk-* /tmp/NeoRadio-install-* 2>/dev/null || true
) >/dev/null 2>&1 &
exit 0
